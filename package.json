{
  "name": "matthematical-kalma",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "vinext build",
    "build:staging": "CLOUDFLARE_ENV=staging vinext build",
    "build:production": "CLOUDFLARE_ENV=production vinext build",
    "start": "vinext start",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next --ignore-pattern worker-configuration.d.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test",
    "test:intelligence:d1": "node scripts/validate-intelligence-d1.mjs",
    "migrations:validate": "node scripts/validate-migrations.mjs",
    "deploy:guard:test": "node --test tests/cloudflare-deploy-guard.test.mjs",
    "migrations:apply:local": "wrangler d1 migrations apply DB --local",
    "migrations:list:local": "wrangler d1 migrations list DB --local",
    "d1:validate:local": "wrangler d1 execute DB --local --command \"PRAGMA foreign_key_check\" && wrangler d1 execute DB --local --command \"SELECT singleton_id, schema_contract_version FROM platform_schema_metadata\"",
    "security:secrets": "node scripts/scan-secrets.mjs",
    "worker:types": "wrangler types",
    "worker:types:check": "wrangler types --check"
  },
  "dependencies": {
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "1.0.0-beta.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
